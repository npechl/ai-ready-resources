{
  "@context": [
    "../schemas/context.jsonld",
    {
      "@base": "https://example.org/embl-ebi/ai-readiness/"
    }
  ],
  "id": "criterion/retention-and-deletion",
  "type": [
    "AssessmentCriterion",
    "skos:Concept"
  ],
  "identifier": "retention-and-deletion",
  "name": "Retention and deletion",
  "inScheme": "scheme",
  "principle": "principle/governance-legal-and-ethics",
  "requirement": "Obligations to keep, withdraw, correct and delete data must be documented and carried out everywhere the data appears, including derived data and caches where relevant.",
  "requirementLevel": [
    "must"
  ],
  "howToAssess": "Follow a real or test withdrawal/correction through public access, search indexes, derived data and audit logs.",
  "assessmentObjectLabel": "Data lifecycle",
  "assessmentObject": [
    "object/data-lifecycle"
  ],
  "applicability": "All resources. The obligations depend on the type of data and the deposit agreements.",
  "evidence": [
    "Retention schedule",
    "withdrawal process",
    "correction/tombstone policy",
    "test/audit record"
  ],
  "sharesEvidenceWith": [
    "criterion/long-term-access",
    "criterion/release-immutability"
  ],
  "assessmentFrequency": "At least annually"
}
