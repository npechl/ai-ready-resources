{
  "@context": [
    "../schemas/context.jsonld",
    {
      "@base": "https://example.org/embl-ebi/ai-readiness/"
    }
  ],
  "id": "criterion/change-and-deprecation-policy",
  "type": [
    "AssessmentCriterion",
    "skos:Concept"
  ],
  "identifier": "change-and-deprecation-policy",
  "name": "Change and deprecation policy",
  "inScheme": "scheme",
  "principle": "principle/documentation",
  "requirement": "Changes that break existing use, and the retirement of features, must follow a published process with advance notice and guidance on how to switch.",
  "requirementLevel": [
    "must"
  ],
  "howToAssess": "Review the policy. Check a sample of past breaking changes: was notice given, was the old version supported for the promised time, and was a migration guide published?",
  "assessmentObjectLabel": "Schema/API",
  "assessmentObject": [
    "object/schema",
    "object/api"
  ],
  "applicability": "All evolving schemas, formats and APIs.",
  "evidence": [
    "Versioning policy",
    "deprecation notices",
    "migration guides",
    "compatibility tests"
  ],
  "sharesEvidenceWith": [
    "criterion/version-and-change-history",
    "criterion/documentation-versioning"
  ],
  "assessmentFrequency": "Per change and annually",
  "relatedStandard": [
    "OpenAPI Specification"
  ],
  "goodExample": "A breaking API change is announced 6 months ahead, both versions run in parallel, and a migration guide is published.",
  "poorExample": "A field is renamed overnight and downstream pipelines fail."
}
