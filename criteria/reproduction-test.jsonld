{
  "@context": [
    "../schemas/context.jsonld",
    {
      "@base": "https://example.org/embl-ebi/ai-readiness/"
    }
  ],
  "id": "criterion/reproduction-test",
  "type": [
    "AssessmentCriterion",
    "skos:Concept"
  ],
  "identifier": "reproduction-test",
  "name": "Reproduction test",
  "inScheme": "scheme",
  "principle": "principle/infrastructure",
  "requirement": "A typical production processing step must be re-run at least once a year and after major pipeline changes, and its output compared with the published output within agreed tolerances.",
  "requirementLevel": [
    "must"
  ],
  "howToAssess": "Re-run the step from the stored inputs on a clean setup. Compare the outputs for meaning, and byte by byte where the process should give identical results.",
  "assessmentObjectLabel": "Pipeline/output",
  "assessmentObject": [
    "object/pipeline-workflow",
    "object/output"
  ],
  "applicability": "All derived/processed resources.",
  "evidence": [
    "Description of how the test is done",
    "run logs",
    "report of differences",
    "reason for the chosen tolerances"
  ],
  "sharesEvidenceWith": [
    "criterion/environment-capture"
  ],
  "assessmentFrequency": "At least annually and after major pipeline change",
  "relatedStandard": [
    "RO-Crate"
  ],
  "goodExample": "Once a year, a step from a past release is re-run from stored inputs on a clean setup and the outputs are compared with the published ones.",
  "poorExample": "The pipeline has never been re-run since it was written."
}
