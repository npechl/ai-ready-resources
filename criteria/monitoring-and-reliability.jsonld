{
  "@context": [
    "../schemas/context.jsonld",
    {
      "@base": "https://example.org/embl-ebi/ai-readiness/"
    }
  ],
  "id": "criterion/monitoring-and-reliability",
  "type": [
    "AssessmentCriterion",
    "skos:Concept"
  ],
  "identifier": "monitoring-and-reliability",
  "name": "Monitoring and reliability",
  "inScheme": "scheme",
  "principle": "principle/infrastructure",
  "requirement": "Critical components for loading, processing and serving data must report their health, failures and how up to date the data is. Production services should set and monitor targets for availability, response time and error rate.",
  "requirementLevel": "must/should",
  "howToAssess": "Review which components are monitored, where alerts go, the runbooks, and monitoring data for a typical reporting period. Trigger a test alert and test the public status/help route.",
  "assessmentObjectLabel": "Service/pipeline",
  "assessmentObject": [
    "object/service",
    "object/pipeline-workflow"
  ],
  "applicability": "N/A only for preserved static releases without operational components.",
  "evidence": [
    "List of monitored components",
    "alert definitions",
    "runbooks",
    "data-freshness measures",
    "SLO/SLA",
    "monitoring dashboard/export",
    "incident history",
    "status page"
  ],
  "sharesEvidenceWith": [
    "criterion/findability-and-support",
    "criterion/issue-correction-and-appeal-route"
  ],
  "assessmentFrequency": "Quarterly",
  "goodExample": "Dashboards and alerts for availability, error rate and data freshness, plus a public status page.",
  "poorExample": "Users are the first to notice the API is down or the data is three months stale."
}
