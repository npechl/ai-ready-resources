  "identifier": "mapping-semantics-and-provenance",
  "name": "Mapping semantics and provenance",
  "inScheme": "scheme",
  "principle": "principle/semantic-interoperability",
  "requirement": "Mappings between schemas or ontologies must state the type of match (exact, broader, narrower or related), how the mapping was made, the target version, who made it and whether it was reviewed or how confident it is.",
  "requirementLevel": [
    "must"
  ],
  "howToAssess": "Look at a sample of exact, broader, narrower and related mappings. Check the information on how each was created and reviewed.",
  "assessmentObjectLabel": "Mappings",
  "assessmentObject": [
    "object/mapping"
  ],
  "applicability": "N/A where no mappings are made or distributed.",
  "evidence": [
    "Mapping file",
    "definitions of the match types",
    "method/version",
    "review/confidence fields"
  ],
  "assessmentFrequency": "Per mapping release"
}
