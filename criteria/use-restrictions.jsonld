{
  "@context": [
    "../schemas/context.jsonld",
    {
      "@base": "https://example.org/embl-ebi/ai-readiness/"
    }
  ],
  "id": "criterion/use-restrictions",
  "type": [
    "AssessmentCriterion",
    "skos:Concept"
  ],
  "identifier": "use-restrictions",
  "name": "Use restrictions",
  "inScheme": "scheme",
  "principle": "principle/governance-legal-and-ethics",
  "requirement": "Uses that are allowed, not allowed or allowed under conditions must be documented, and readable by software where automated use depends on them.",
  "requirementLevel": [
    "must"
  ],
  "howToAssess": "Compare the machine-readable codes with the policy they come from and with actual access decisions. Test typical records.",
  "assessmentObjectLabel": "Dataset/records",
  "assessmentObject": [
    "object/dataset",
    "object/record"
  ],
  "applicability": "If there are no restrictions beyond the licence, say so explicitly.",
  "evidence": [
    "Restriction codes",
    "table linking codes to policy",
    "access conditions",
    "report checking they match"
  ],
  "assessmentFrequency": "Per policy/release change",
  "goodExample": "EGA datasets carry machine-readable data use conditions as GA4GH DUO codes (e.g. \"general research use\").",
  "poorExample": "Use conditions exist only in a PDF agreement that software cannot read."
}
